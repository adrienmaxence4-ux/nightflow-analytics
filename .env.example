# ───────────────────────────────────────────────────────────
# Nightflow Analytics — Environment variables
# Copy this file to `.env.local` and fill in your values.
# The app runs in DEMO MODE (mock data, fake auth) when these
# are left empty — so you can clone & run immediately.
# ───────────────────────────────────────────────────────────

# Supabase (Auth + Database) — https://app.supabase.com → Project settings → API
# User-facing requests use ONLY the public anon key + Row-Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-ONLY, RLS-bypassing. Used EXCLUSIVELY by the
# session-less integration engine (signature-verified webhooks + cron workers).
# Never exposed to the browser or any user-facing route. Required for webhooks
# and background sync to function.
SUPABASE_SERVICE_ROLE_KEY=

# ── Integration engine ──────────────────────────────────────
# Encrypts OAuth/API tokens at rest (AES-256-GCM, scrypt-derived). Any strong
# random string; set in production. Unset = tokens stored in plaintext (dev).
INTEGRATIONS_ENC_KEY=
# Shared secret guarding the cron worker endpoints (/api/integrations/sync,
# /api/integrations/jobs/process). Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Stripe webhook signing secret (whsec_…) for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# Meta Ads / TikTok Ads app secrets (future-ready — webhook verification).
META_APP_SECRET=
TIKTOK_APP_SECRET=

# Public site URL (used for auth + OAuth redirects). In Vercel set this to your
# production domain, e.g. https://nightflow-analytics.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin allowlist (comma-separated emails). These users can use the demo/test
# data tools, which are hidden from real customers. Leave empty in production to
# lock the tools down entirely.
ADMIN_EMAILS=

# ── AI Copilot ──────────────────────────────────────────────
# Choose the provider: "github" (free, for testing) | "anthropic" (paid) | "auto"
AI_PROVIDER=auto

# Option 1 — GitHub Models (FREE, ideal for test mode)
# Create a fine-grained PAT with the "Models" (read) permission:
# https://github.com/settings/personal-access-tokens  →  set AI_PROVIDER=github
GITHUB_MODELS_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference

# Option 2 — Anthropic Claude (paid, for production)
# Get a key at https://console.anthropic.com  →  set AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-4-8). e.g. claude-sonnet-4-6
AI_MODEL=

# ── Shopify (OAuth — Dev Dashboard app) ──
# App URL      = <NEXT_PUBLIC_SITE_URL>/api/integrations/shopify
# Redirect URL = <NEXT_PUBLIC_SITE_URL>/api/integrations/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Les scopes write_* autorisent le bouton « Appliquer » (le SaaS modifie
# lui-même prix / stock / visibilité / codes promo). Sans eux Nightflow reste
# en lecture seule et l'application d'une recommandation demande une
# reconnexion. Une boutique déjà connectée doit se reconnecter une fois pour
# accorder les nouveaux droits.
# SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,write_inventory,write_discounts

# ── Stripe ──
# Used for BOTH "Connect with Stripe" (one-click data import) and subscription
# billing (Checkout / Customer Portal / plan changes).
#   STRIPE_SECRET_KEY        = platform secret key (sk_live_… / sk_test_…)
#   STRIPE_CONNECT_CLIENT_ID = Connect client id (ca_…), Standard OAuth enabled
# Redirect URL = <NEXT_PUBLIC_SITE_URL>/api/integrations/stripe/oauth/callback
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=

# ── Klaviyo (OAuth 2.0 + PKCE) ──
# Redirect URL = <NEXT_PUBLIC_SITE_URL>/api/integrations/klaviyo/oauth/callback
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=

# ── Google (OAuth → Google Analytics GA4) ──
# Redirect URL = <NEXT_PUBLIC_SITE_URL>/api/integrations/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Meta Ads (OAuth — connexion en un clic) ──
# App sur developers.facebook.com → produit « Marketing API ».
# Redirect URL = <NEXT_PUBLIC_SITE_URL>/api/integrations/meta/oauth/callback
# Scope demandé : ads_read uniquement (lecture, jamais de gestion de campagne).
# Sans App Review, la connexion ne marche que sur les comptes publicitaires
# dont le propriétaire de l'app a un rôle — suffisant pour tester le parcours.
# Pour vos clients : Business Manager vérifié + App Review sur ads_read.
# Toutes les versions Marketing API < v24.0 ont été supprimées le 2026-06-09.
META_APP_ID=
META_APP_SECRET=
# Configuration Facebook Login for Business (Paramètres > Configurations).
# Elle porte les autorisations (ads_read), le type d'élément (comptes
# publicitaires) et la tâche (ANALYZE) — l'URL d'autorisation ne transmet que
# son id, pas un scope. Valeur publique. Sans elle, le connecteur retombe sur
# le login classique avec scope=ads_read.
META_LOGIN_CONFIG_ID=
# META_API_VERSION=v25.0
